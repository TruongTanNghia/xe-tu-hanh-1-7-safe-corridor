<?xml version="1.0"?>
<package format="3">
  <name>rc_actuation</name>
  <version>0.1.0</version>
  <description>Single-writer safety boundary between NMPC and micro-ROS PWM.</description>
  <maintainer email="phibui2112@gmail.com">RC Car Project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rc_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>micro_ros_agent</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
